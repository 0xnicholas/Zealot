 {
  "description": "anyOf with one empty schema",
  "schema": {
   "anyOf": [
    {
     "type": "number"
    },
    {}
   ]
  },
  "tests": [
   {
    "description": "string is valid",
    "data": "foo",
    "valid": true
   }
  ]
 },
 {
  "description": "anyOf with one empty schema",
  "schema": {
   "anyOf": [
    {
     "type": "number"
    },
    {}
   ]
  },
  "tests": [
