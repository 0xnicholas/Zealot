  ]
 },
 {
  "description": "anyOf complex types",
  "schema": {
   "anyOf": [
    {
     "properties": {
      "bar": {
       "type": "integer"
      }
     },
     "required": [
      "bar"
     ]
    },
    {
     "properties": {
      "foo": {
       "type": "string"
      }
     },
     "required": [
      "foo"
     ]
    }
   ]
  },
  "tests": [
